{
  "name": "@nota/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "release": "TAURI_SIGNING_PRIVATE_KEY=$(cat ~/.tauri/nota-updater.key) TAURI_SIGNING_PRIVATE_KEY_PASSWORD=$(cat ~/.tauri/nota-updater.password) tauri build -c src-tauri/tauri.release.conf.json",
    "web": "vite",
    "web:build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3",
    "@tauri-apps/plugin-updater": "~2.12",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7"
  }
}
