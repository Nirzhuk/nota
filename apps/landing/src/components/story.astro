---
import Icon from "./icon.astro";
import NoteCard from "./note.astro";
import Nota from "./nota.astro";
import { POSTS } from "../notes";
const tauri = POSTS.find((p) => p.source === "github")!;
---
<section class="story" id="story" data-story aria-label="How Nota works">
  <div class="pin">
    <div class="caps">
      <div class="cap on" data-cap>
        <h2 class="heading-3">Click like you always do</h2>
        <p class="body-3 dim">Star, like, upvote or save. <Nota /> keeps the post the moment you click, and you don't change a thing about how you browse.</p>
      </div>
      <div class="cap" data-cap>
        <h2 class="heading-3">Or save any page by hand</h2>
        <p class="body-3 dim">
          Use the toolbar button, the right click menu, or{" "}
          <span class="keys only-mac"><kbd>⌥</kbd><kbd>⇧</kbd><kbd>S</kbd></span>
          <span class="keys only-win"><kbd>Alt</kbd><kbd>Shift</kbd><kbd>S</kbd></span>
          <span class="only-other">Alt Shift S</span>
        </p>
      </div>
      <div class="cap" data-cap>
        <h2 class="heading-3">It goes straight to the app</h2>
        <p class="body-3 dim">From the extension to the app on your computer. App closed? The extension holds your saves and sends them the next time it opens.</p>
      </div>
      <div class="cap" data-cap>
        <h2 class="heading-3">Then find it again</h2>
        <p class="body-3 dim">Search everything, filter by site, and sort things into folders and tags.</p>
      </div>
    </div>

    <div class="view">
      <div class="stage" data-stage>
        <div class="browser" data-browser>
          <img src="/img/browser.png" width="1120" height="611" alt="A GitHub repository open in Chrome, with the Star button highlighted" />
          <span class="ring" data-ring></span>
          <img class="popup" data-popup src="/img/popup.png" width="398" height="330" alt="The Nota extension popup, listing recent saves from GitHub, Reddit and YouTube" />
          <span class="badge caption-4" data-badge>1</span>
          <span class="cursor" data-cursor><Icon name="cursor" size={32} /></span>
        </div>
        <div class="app" data-app>
          <img src="/img/app.png" width="914" height="640" alt="The Nota app showing a grid of saved posts, with a sidebar of sites and a search field" />
        </div>
        <div class="toast caption-4 inpage" data-toast><Icon name="checkCircle" size={16} /><span>Saved to Nota</span></div>
        <span class="line" data-line></span>
        <span class="chip caption-4" data-chip>No server in between</span>
        <div class="flying" data-flying><NoteCard note={{ ...tauri, when: "now", id: "story" }} /></div>
      </div>
    </div>

    <div class="rail" aria-hidden="true">{[0, 1, 2, 3].map(() => <i><b data-fill></b></i>)}</div>
  </div>
</section>

<style>
  .story { position: relative; height: 500vh; margin-top: var(--s-900); }
  .pin {
    position: sticky; top: 0;
    display: flex; flex-direction: column; gap: var(--s-200);
    height: 100vh; height: 100svh;
    padding: 88px var(--gutter) var(--s-300);
    overflow: clip;
  }
  .caps { position: relative; z-index: 2; display: grid; flex: none; justify-items: center; text-align: center; }
  .cap {
    grid-area: 1 / 1; max-width: 680px;
    opacity: 0; transform: translateY(var(--s-300));
    transition: opacity var(--move) var(--ease), transform var(--move) var(--ease);
    pointer-events: none;
  }
  .cap.on { opacity: 1; transform: none; }
  .cap p { margin-top: var(--s-75); }
  .keys { gap: var(--s-50); vertical-align: middle; }
  .keys kbd { min-width: var(--s-400); height: var(--s-400); }
  .view { flex: 1; min-height: 0; display: grid; place-items: center; container-type: size; }
  .stage { position: relative; width: min(100cqw, 160cqh); aspect-ratio: 16 / 10; }
  .browser, .app {
    position: absolute; left: 50%; top: 50%;
    border-radius: var(--r-xl);
    box-shadow: var(--lift-far);
    will-change: transform, opacity;
    transform: translate(-50%, -50%);
  }
  .browser { width: 86%; }
  .app { width: 72%; opacity: 0; }
  .browser > img:first-child, .app > img { width: 100%; height: auto; border-radius: var(--r-xl); }
  .popup { position: absolute; left: 64.46%; top: 6.87%; width: 35.54%; height: auto; border-radius: var(--r-lg); box-shadow: var(--lift); opacity: 0; transform-origin: 90% 0; }
  .ring { position: absolute; left: 84.55%; top: 23.4%; width: 9%; aspect-ratio: 1; margin: -4.5% 0 0 -4.5%; border: 2px solid var(--saved); border-radius: var(--r-full); opacity: 0; }
  .badge { position: absolute; left: 97.4%; top: 1%; display: grid; place-items: center; width: var(--s-200); height: var(--s-200); background: var(--saved); color: #fff; border-radius: var(--r-full); opacity: 0; font-variant-numeric: tabular-nums; }
  .inpage { position: absolute; left: 50%; bottom: 16%; opacity: 0; }
  .cursor { position: absolute; left: 0; top: 0; color: #fff; opacity: 0; filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.7)); }
  .flying { position: absolute; left: 50%; top: 50%; width: 240px; opacity: 0; will-change: transform, opacity; }
  .flying :global(.note) { border-color: var(--saved); box-shadow: var(--lift-far); }
  .line { position: absolute; left: 50%; top: 50%; width: 12%; height: 0; border-top: 2px dashed var(--saved); opacity: 0; margin-left: -6%; }
  .chip { position: absolute; left: 50%; top: 50%; padding: var(--s-50) var(--s-75); background: var(--bg); border: 1px solid var(--saved); border-radius: var(--r-full); white-space: nowrap; opacity: 0; }
  .rail { position: relative; z-index: 2; flex: none; display: flex; justify-content: center; gap: var(--s-75); }
  .rail i { width: var(--s-500); height: var(--s-50); background: var(--chip); border-radius: var(--r-full); overflow: hidden; }
  .rail b { display: block; height: 100%; background: var(--fg); transform: scaleX(0); transform-origin: left; }

  @media (max-width: 720px) {
    .stage { width: min(100cqw, 90cqh); aspect-ratio: 1 / 1.1; }
    .browser, .app { width: 100%; }
    .flying { width: 180px; }
    .inpage { bottom: 28%; }
    .line { width: 0; }
    .keys kbd { min-width: var(--s-300); height: var(--s-300); font-size: 14px; line-height: 20px; }
  }
  :global(html:not(.js)) .story { height: auto; }
  :global(html:not(.js)) .pin { height: auto; }
  :global(html:not(.js)) .cap { grid-area: auto; opacity: 1; transform: none; margin-bottom: var(--s-300); }
  :global(html:not(.js)) .view { container-type: normal; }
  :global(html:not(.js)) .stage { width: 100%; }
</style>

<script>
  import { scroll } from "motion";

  const root = document.querySelector<HTMLElement>("[data-story]")!;
  const $ = <T extends HTMLElement>(k: string) => root.querySelector<T>(`[data-${k}]`)!;
  const stage = $("stage"), browser = $("browser"), app = $("app"), popup = $("popup"), ring = $("ring");
  const toast = $("toast"), badge = $("badge"), cursor = $("cursor"), flying = $("flying"), line = $("line"), chip = $("chip");
  const caps = [...root.querySelectorAll<HTMLElement>("[data-cap]")];
  const fills = [...root.querySelectorAll<HTMLElement>("[data-fill]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const STARTS = [0, 0.27, 0.5, 0.76]; // where each of the four chapters begins
  const POSES = [0.19, 0.4, 0.72, 1]; // reduced motion jumps between these and fades
  const STAR = { x: 0.8455, y: 0.234 }; // positions inside browser.png
  const ICON = { x: 0.966, y: 0.036 };
  const CARD = { x: 0.395, y: 0.2, w: 0.372 }; // the first card inside app.png

  const clamp = (t: number) => Math.min(1, Math.max(0, t));
  const out = (t: number) => 1 - (1 - t) ** 3; // decelerate into place
  const seg = (p: number, a: number, b: number) => out(clamp((p - a) / (b - a)));
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;

  let W = 0, H = 0, bw = 0, bh = 0, aw = 0, ah = 0, fw = 0, narrow = false;
  const measure = () => {
    W = stage.offsetWidth; H = stage.offsetHeight;
    bw = browser.offsetWidth; bh = browser.offsetHeight;
    aw = app.offsetWidth; ah = app.offsetHeight;
    fw = flying.offsetWidth;
    narrow = W < 500;
  };

  const place = (el: HTMLElement, x: number, y: number, s = 1, rot = 0) => {
    el.style.transform = `translate(-50%,-50%) translate(${x}px,${y}px) scale(${s}) rotate(${rot}deg)`;
  };

  function render(p: number) {
    // Camera on the browser: push in on the Star button, back out, then step aside.
    const push = seg(p, 0.03, 0.15) - seg(p, 0.2, 0.28);
    const zoom = 1 + (narrow ? 1.1 : 0.6) * push;
    const sync = seg(p, 0.5, 0.6);
    const find = seg(p, 0.76, 0.86);

    const b3 = narrow ? { x: 0, y: -H * 0.3, s: 0.6 } : { x: -W * 0.28, y: 0, s: 0.42 };
    const a3 = narrow ? { x: 0, y: H * 0.2, s: 0.66 } : { x: W * 0.25, y: 0, s: 0.62 };
    const aEnd = narrow ? 1 : Math.min(1.25, (H * 0.98) / ah);

    const bs = zoom * mix(1, b3.s, sync);
    const bx = -(STAR.x - 0.5) * bw * zoom * push + b3.x * sync - W * 0.2 * find;
    const by = -(STAR.y - 0.5) * bh * zoom * push + b3.y * sync;
    place(browser, bx, by, bs);
    browser.style.opacity = String(1 - find);

    const ax = mix(mix(W * 0.7, a3.x, sync), 0, find);
    const ay = mix(mix(narrow ? H * 0.4 : 0, a3.y, sync), 0, find);
    const as = mix(a3.s, aEnd, find);
    place(app, ax, ay, as);
    app.style.opacity = String(seg(p, 0.5, 0.56));

    // Cursor: to the star, click, then up to the toolbar icon.
    const toStar = seg(p, 0.04, 0.13);
    const toIcon = seg(p, 0.28, 0.34);
    const cx = mix(mix(0.5, STAR.x, toStar), ICON.x, toIcon) * bw;
    const cy = mix(mix(0.9, STAR.y, toStar), ICON.y, toIcon) * bh;
    const clicking = (p > 0.135 && p < 0.16) || (p > 0.335 && p < 0.355);
    cursor.style.transform = `translate(${cx}px,${cy}px) scale(${(clicking ? 0.8 : 1) / Math.max(1, zoom * 0.8)})`;
    cursor.style.opacity = String(seg(p, 0.02, 0.05) - seg(p, 0.44, 0.48));

    const r = clamp((p - 0.14) / 0.08);
    ring.style.transform = `scale(${1 + r})`;
    ring.style.opacity = String(p > 0.14 ? 1 - r : 0);

    // The real pill rises from the bottom of the page on click. It lives on the stage,
    // not the browser, so the camera push can't carry it out of frame.
    const pill = seg(p, 0.145, 0.17) - seg(p, 0.25, 0.28);
    toast.style.opacity = String(pill);
    toast.style.transform = `translate(-50%, ${(1 - pill) * 24}px)`;

    const openPop = seg(p, 0.34, 0.39) - seg(p, 0.46, 0.5);
    popup.style.opacity = String(openPop);
    popup.style.transform = `translateY(${(1 - openPop) * -12}px) scale(${mix(0.94, 1, openPop)})`;

    const badgeOn = seg(p, 0.27, 0.29) - seg(p, 0.58, 0.6);
    badge.style.opacity = String(badgeOn);
    badge.style.transform = `scale(${mix(0.2, 1, badgeOn)})`;

    // The saved card: pops from the star, drops into the toolbar, later flies to the app.
    const appear = seg(p, 0.16, 0.2);
    const toTool = seg(p, 0.22, 0.28);
    const iconX = (ICON.x - 0.5) * bw, iconY = (ICON.y - 0.5) * bh;
    const fly = seg(p, 0.6, 0.73);
    const landX = (CARD.x - 0.5) * aw * as + ax;
    const landY = (CARD.y - 0.5) * ah * as + ay;
    const landS = (CARD.w * aw * as) / fw;
    let fx, fy, fs, fo;
    if (p < 0.5) {
      fx = mix(0, iconX, toTool);
      fy = mix(-H * 0.24 * appear, iconY, toTool);
      fs = mix(appear, 0.1, toTool);
      fo = appear * (1 - toTool);
    } else {
      const startX = iconX * b3.s + b3.x, startY = iconY * b3.s + b3.y;
      const arc = Math.sin(clamp((p - 0.6) / 0.13) * Math.PI) * (narrow ? 0 : -H * 0.22);
      fx = mix(startX, landX, fly);
      fy = mix(startY, landY, fly) + arc;
      fs = mix(0.15, landS, fly);
      fo = seg(p, 0.6, 0.62);
    }
    place(flying, fx, fy, fs, (1 - fly) * (p < 0.5 ? 0 : -6));
    flying.style.opacity = String(fo);

    // The dashed path and its label sit in the gap between the two windows.
    const lineOn = seg(p, 0.56, 0.62) * (1 - find);
    const gapX = narrow ? 0 : W * -0.036, gapY = narrow ? -H * 0.08 : 0;
    line.style.opacity = String(lineOn);
    line.style.transformOrigin = "left center";
    line.style.transform = narrow
      ? "scaleX(0)"
      : `translate(${gapX}px,${gapY}px) scaleX(${lineOn})`;
    chip.style.opacity = String(lineOn);
    place(chip, gapX, gapY + (narrow ? 0 : H * 0.12));

    // Captions and progress.
    let step = 0;
    STARTS.forEach((s, i) => { if (p >= s) step = i; });
    caps.forEach((c, i) => c.classList.toggle("on", i === step));
    fills.forEach((f, i) => {
      const end = STARTS[i + 1] ?? 1;
      f.style.transform = `scaleX(${clamp((p - STARTS[i]) / (end - STARTS[i]))})`;
    });
    return step;
  }

  measure();
  new ResizeObserver(() => { measure(); render(current); }).observe(stage);

  // Smooth the scrub a little so wheel steps read as weight rather than jumps.
  let target = 0, current = 0, raf = 0, lastStep = -1;
  const loop = () => {
    current += (target - current) * 0.14;
    if (Math.abs(target - current) < 0.0004) current = target;
    render(current);
    raf = current === target ? 0 : requestAnimationFrame(loop);
  };

  scroll(
    (p: number) => {
      if (reduced) {
        let step = 0;
        STARTS.forEach((s, i) => { if (p >= s) step = i; });
        if (step !== lastStep) {
          lastStep = step;
          render(POSES[step]);
          stage.animate({ opacity: [0, 1] }, { duration: 300, easing: "cubic-bezier(0.22,1,0.36,1)" });
        }
        return;
      }
      target = p;
      if (!raf) raf = requestAnimationFrame(loop);
    },
    { target: root, offset: ["start start", "end end"] },
  );
  render(reduced ? POSES[0] : 0);
</script>
